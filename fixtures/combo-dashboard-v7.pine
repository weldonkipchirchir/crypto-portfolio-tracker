// Pine Script - Mozilla Public License 2.0 - https://mozilla.org/MPL/2.0/
//@version=6
indicator("Combo Dashboard v7 (Scored Signals)", overlay = false, shorttitle = "Dashboard v7", max_labels_count = 500)
// ===================== INPUTS =====================
gEma = "Trend Filter (EMA)"
showEma50  = input.bool(true, "Show EMA 50")
showEma200 = input.bool(true, "Show EMA 200")
trendMode  = input.string("EMA 50 vs 200", "Trend filter", options = ["EMA 200", "EMA 50 vs 200", "Off"])
gHtf = "Higher Timeframe Filter"
useHtf   = input.bool(true, "Require higher-timeframe trend agreement")
htfInput = input.timeframe("", "Higher timeframe (blank = auto one step up)")
htfLen   = input.int(50, "HTF EMA length")
gBb = "Volatility (Bollinger Bands)"
showBb = input.bool(true, "Show Bollinger Bands")
bbLen  = input.int(20, "BB Length")
bbMult = input.float(2.0, "BB StdDev Multiplier")
gRsi = "Momentum (RSI)"
showRsi = input.bool(false, "Show RSI Pane")
rsiLen  = input.int(14, "RSI Length")
rsiBuy  = input.int(35, "RSI dip level (buy)")
rsiSell = input.int(65, "RSI spike level (sell)")
gMacd = "Momentum (MACD)"
showMacd = input.bool(true, "Show MACD Pane")
macdFast = input.int(12, "MACD Fast Length")
macdSlow = input.int(26, "MACD Slow Length")
macdSig  = input.int(9, "MACD Signal Length")
macdZero = input.bool(true, "Buys need cross below 0 / sells above 0")
gSig = "Signal Settings"
lookback  = input.int(6, "Dip/Spike memory (bars)", minval = 1)
cooldown  = input.int(10, "Min bars between signals", minval = 1)
minScore  = input.int(4, "Min score for STRONG signal (of 5)", minval = 1, maxval = 5)
showEarly = input.bool(true, "Show EARLY (lower score) signals")
earlyMin  = input.int(2, "Min score for EARLY signal", minval = 0, maxval = 5)
gFilt = "Filters (each is worth 1 score point)"
useAdx = input.bool(true, "ADX strength + direction (+DI / -DI)")
adxLen = input.int(14, "ADX Length")
adxMin = input.int(20, "Min ADX")
useVol = input.bool(true, "Volume above average")
volLen = input.int(20, "Volume average length")
useSqz = input.bool(true, "Skip squeeze / chop regime")
sqzMin = input.int(20, "Min BB-width percentile (0-100)", minval = 0, maxval = 100)
gRisk = "Targets & Stops"
showLabels = input.bool(true, "Show labels with SL/TP")
atrLen     = input.int(14, "ATR Length")
slMode     = input.string("Swing", "Stop mode", options = ["Swing", "ATR"])
slMult     = input.float(1.5, "ATR mode: Stop (x ATR)")
swingLen   = input.int(10, "Swing mode: lookback bars")
maxRiskAtr = input.float(3.0, "Swing mode: max risk (x ATR)")
rrTarget   = input.float(2.0, "Take profit (R multiple)")
gMisc = "Display"
showVwap = input.bool(true, "Show VWAP (intraday only)")
showDash = input.bool(true, "Show dashboard")

// ===================== CALCULATIONS =====================
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
[bbMid, bbUp, bbLo] = ta.bb(close, bbLen, bbMult)
rsiVal = ta.rsi(close, rsiLen)
[macdLine, sigLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSig)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
atrVal = ta.atr(atrLen)
bullCross = ta.crossover(macdLine, sigLine)
bearCross = ta.crossunder(macdLine, sigLine)
// Auto higher timeframe: always one step above the chart
tfSec = timeframe.in_seconds()
autoTf = tfSec <= 900 ? "60" : tfSec <= 3600 ? "240" : tfSec <= 14400 ? "D" : tfSec <= 86400 ? "W" : "M"
htfTf = htfInput == "" ? autoTf : htfInput
[htfClose, htfEma] = request.security(syminfo.tickerid, htfTf, [close[1], ta.ema(close, htfLen)[1]], lookahead = barmerge.lookahead_on)
htfUp   = not useHtf or htfClose > htfEma
htfDown = not useHtf or htfClose < htfEma
// Volume and regime
volOk    = not useVol or na(volume) or volume > ta.sma(volume, volLen)
bbRank   = ta.percentrank((bbUp - bbLo) / bbMid, 100)
regimeOk = not useSqz or bbRank >= sqzMin

// ===================== SIGNAL LOGIC =====================
dipRecent   = ta.barssince(low < bbLo or rsiVal < rsiBuy) <= lookback
spikeRecent = ta.barssince(high > bbUp or rsiVal > rsiSell) <= lookback
trendUp = switch trendMode
    "EMA 200"       => close > ema200
    "EMA 50 vs 200" => ema50 > ema200
    => true
trendDown = switch trendMode
    "EMA 200"       => close < ema200
    "EMA 50 vs 200" => ema50 < ema200
    => true
adxBuyOk  = not useAdx or (adxVal >= adxMin and diPlus > diMinus)
adxSellOk = not useAdx or (adxVal >= adxMin and diMinus > diPlus)
// Mandatory trigger: recent dip/spike + MACD cross (+ optional zero-line side)
buyTrigger  = barstate.isconfirmed and dipRecent and bullCross and (not macdZero or macdLine < 0)
sellTrigger = barstate.isconfirmed and spikeRecent and bearCross and (not macdZero or macdLine > 0)
// Score: 5 independent-ish checks
buyScore  = (trendUp ? 1 : 0) + (htfUp ? 1 : 0) + (adxBuyOk ? 1 : 0) + (volOk ? 1 : 0) + (regimeOk ? 1 : 0)
sellScore = (trendDown ? 1 : 0) + (htfDown ? 1 : 0) + (adxSellOk ? 1 : 0) + (volOk ? 1 : 0) + (regimeOk ? 1 : 0)
var int lastDir = 0
var int lastBar = -1000
strongBuy  = buyTrigger  and buyScore  >= minScore and lastDir != 1  and bar_index - lastBar >= cooldown
strongSell = sellTrigger and sellScore >= minScore and lastDir != -1 and bar_index - lastBar >= cooldown
if strongBuy
    lastDir := 1
    lastBar := bar_index
if strongSell
    lastDir := -1
    lastBar := bar_index
earlyBuy  = showEarly and buyTrigger  and not strongBuy and not strongSell and buyScore  >= earlyMin
earlySell = showEarly and sellTrigger and not strongBuy and not strongSell and sellScore >= earlyMin
// ===================== TARGETS =====================
swingLow  = ta.lowest(low, swingLen)
swingHigh = ta.highest(high, swingLen)
buyRisk  = slMode == "ATR" ? atrVal * slMult : math.min(close - swingLow + atrVal * 0.25, atrVal * maxRiskAtr)
sellRisk = slMode == "ATR" ? atrVal * slMult : math.min(swingHigh - close + atrVal * 0.25, atrVal * maxRiskAtr)
buySL  = close - buyRisk
buyTP  = close + buyRisk * rrTarget
sellSL = close + sellRisk
sellTP = close - sellRisk * rrTarget

// ===================== PLOTS (MAIN CHART) =====================
plot(showEma50 ? ema50 : na, "EMA 50", color = color.blue, linewidth = 2, force_overlay = true)
plot(showEma200 ? ema200 : na, "EMA 200", color = color.orange, linewidth = 2, force_overlay = true)
plot(showVwap and timeframe.isintraday ? ta.vwap(hlc3) : na, "VWAP", color = color.fuchsia, linewidth = 2, style = plot.style_cross, force_overlay = true)
pUp = plot(showBb ? bbUp : na, "BB Upper", color = color.new(color.gray, 50), force_overlay = true)
pLo = plot(showBb ? bbLo : na, "BB Lower", color = color.new(color.gray, 50), force_overlay = true)
fill(pUp, pLo, color = color.new(color.gray, 90), title = "BB Fill")
plotshape(strongBuy,  "Strong Buy",  shape.triangleup,   location.belowbar, color.lime, size = size.normal, force_overlay = true)
plotshape(strongSell, "Strong Sell", shape.triangledown, location.abovebar, color.red,  size = size.normal, force_overlay = true)
plotshape(earlyBuy,   "Early Buy",   shape.triangleup,   location.belowbar, color.new(color.teal, 20),   size = size.tiny, force_overlay = true)
plotshape(earlySell,  "Early Sell",  shape.triangledown, location.abovebar, color.new(color.maroon, 20), size = size.tiny, force_overlay = true)
f_label(side, score, sl, tp) =>
    side + " " + str.tostring(score) + "/5 @ " + str.tostring(close, format.mintick) + "\nSL: " + str.tostring(sl, format.mintick) + "\nTP: " + str.tostring(tp, format.mintick) + " (" + str.tostring(rrTarget, "#.#") + "R)"
if showLabels and strongBuy
    label.new(bar_index, low, f_label("BUY", buyScore, buySL, buyTP), style = label.style_label_up, color = color.green, textcolor = color.white, size = size.small, force_overlay = true)
if showLabels and strongSell
    label.new(bar_index, high, f_label("SELL", sellScore, sellSL, sellTP), style = label.style_label_down, color = color.red, textcolor = color.white, size = size.small, force_overlay = true)
bgcolor(adxVal > 25 ? color.new(color.gray, 95) : na, title = "Strong Trend Filter")
// ===================== PLOTS (SEPARATE PANE) =====================
rsiDisp = showRsi ? display.all : display.none
plot(showRsi ? rsiVal : na, "RSI", color = color.purple, display = rsiDisp)
hline(70, "RSI Overbought", color = color.red, linestyle = hline.style_dashed, display = rsiDisp)
hline(30, "RSI Oversold", color = color.green, linestyle = hline.style_dashed, display = rsiDisp)
plot(showMacd ? macdLine : na, "MACD Line", color = color.blue)
plot(showMacd ? sigLine : na, "MACD Signal", color = color.orange)
plot(showMacd ? macdHist : na, "MACD Histogram", color = macdHist >= 0 ? color.new(color.green, 50) : color.new(color.red, 50), style = plot.style_columns)
// ===================== ALERTS =====================
alertcondition(strongBuy,  "Strong BUY",  "Strong BUY signal on {{ticker}} ({{interval}})")
alertcondition(strongSell, "Strong SELL", "Strong SELL signal on {{ticker}} ({{interval}})")
alertcondition(earlyBuy,   "Early BUY",   "Early BUY on {{ticker}} ({{interval}})")
alertcondition(earlySell,  "Early SELL",  "Early SELL on {{ticker}} ({{interval}})")

// ===================== DASHBOARD TABLE =====================
var table dash = table.new(position.top_left, 2, 9, border_width = 1, border_color = color.gray, frame_width = 2, frame_color = color.gray, bgcolor = color.new(color.black, 10))
f_row(r, name, txt, col, bg = na) =>
    table.cell(dash, 0, r, name, text_size = size.small, text_color = color.white, bgcolor = bg)
    table.cell(dash, 1, r, txt, text_size = size.small, text_color = bg == na ? col : color.white, bgcolor = bg)
if barstate.islast and showDash
    hdr = color.new(color.blue, 50)
    f_row(0, "CHECK", "STATUS (live bar)", color.white, hdr)
    bull = trendUp and not trendDown
    bear = trendDown and not trendUp
    f_row(1, "Chart trend (" + trendMode + ")", bull ? "BULLISH" : bear ? "BEARISH" : "Neutral / off", bull ? color.green : bear ? color.red : color.gray)
    htfBull = htfClose > htfEma
    htfBear = htfClose < htfEma
    f_row(2, "Higher timeframe", not useHtf ? "Filter off" : htfTf + (htfBull ? " BULLISH" : htfBear ? " BEARISH" : " neutral"), not useHtf ? color.gray : htfBull ? color.green : htfBear ? color.red : color.gray)
    adxDir = diPlus > diMinus ? "+DI leads (bulls)" : "-DI leads (bears)"
    f_row(3, "Trend strength", "ADX " + str.tostring(adxVal, "#.#") + " | " + (adxVal >= adxMin ? adxDir : "Choppy, below min"), adxVal < adxMin ? color.red : diPlus > diMinus ? color.green : color.orange)
    f_row(4, "Volume", not useVol ? "Filter off" : volOk ? "Above average" : "Below average", not useVol ? color.gray : volOk ? color.green : color.red)
    f_row(5, "Regime (BB width pctile)", str.tostring(bbRank, "#") + (regimeOk ? " | Expanding / OK" : " | Squeeze / chop"), regimeOk ? color.green : color.red)
    f_row(6, "BUY score", str.tostring(buyScore) + " / 5" + (buyScore >= minScore ? "  (eligible)" : "  (blocked)"), buyScore >= minScore ? color.green : color.gray)
    f_row(7, "SELL score", str.tostring(sellScore) + " / 5" + (sellScore >= minScore ? "  (eligible)" : "  (blocked)"), sellScore >= minScore ? color.red : color.gray)
    verdict = buyScore >= minScore and buyScore > sellScore ? "Longs allowed - wait for dip + MACD cross" : sellScore >= minScore and sellScore > buyScore ? "Shorts allowed - wait for spike + MACD cross" : "No side qualifies - stand aside"
    f_row(8, "VERDICT", verdict, color.white, color.new(color.green, 70))
